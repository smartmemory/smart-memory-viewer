{
  "name": "smart-memory-viewer",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "vite build",
    "build:local": "vite build --config vite.config.local.js",
    "build:sanctuary": "env -u VITE_API_URL -u VITE_CLERK_PUBLISHABLE_KEY -u VITE_PUBLIC_POSTHOG_KEY -u VITE_PUBLIC_POSTHOG_HOST vite build --mode sanctuary --outDir dist-sanctuary",
    "deploy:sanctuary": "npm run build:sanctuary && bash scripts/deploy-sanctuary.sh",
    "preview": "vite preview --port 5178",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.6",
    "@discord/embedded-app-sdk": "^2.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@smartmemory/design-system": "file:../smart-memory-design-system",
    "@smartmemory/graph": "file:../smart-memory-graph",
    "@smartmemory/sdk-js": "file:../smart-memory-sdk-js",
    "@tailwindcss/vite": "^4.1.18",
    "cytoscape": "^3.33.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^2.5.0",
    "lucide-react": "^0.475.0",
    "posthog-js": "^1.438.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
