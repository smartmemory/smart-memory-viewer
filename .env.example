VITE_API_URL=https://api.smartmemory.ai
VITE_WEB_URL=https://www.smartmemory.ai
VITE_WS_URL=wss://api.insights.smartmemory.ai/events

# --- Sanctuary (Discord Activity) build ---
# Set VITE_ALLOW_EMBEDDED=true in the sanctuary deploy pipeline to enable the
# Discord Activity boot path. When true AND the URL carries guild_id +
# channel_id launch params, the viewer skips Clerk SSO and runs the
# /api/graph/claim handshake instead.
# VITE_ALLOW_EMBEDDED=true
# VITE_DISCORD_CLIENT_ID=<DISCORD_APP_ID>
