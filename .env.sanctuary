# Sanctuary (Discord Activity) build profile.
#
# Vite picks this up when building with `--mode sanctuary` (i.e. the
# `build:sanctuary` script in package.json). Do NOT rename, move, or
# bypass — the Discord Activity boot path in src/main.jsx checks
# VITE_ALLOW_EMBEDDED at build time, so the fork is set at bake, not
# runtime. A rebuild without these values will silently regress the
# viewer to the Clerk path and hang at "Connecting to SmartMemory..."
# inside the Activity iframe.
#
# Every value here is non-secret (all of them already ship inside the client
# bundle), so they belong in version control.

VITE_ALLOW_EMBEDDED=true
VITE_DISCORD_CLIENT_ID=1495424851375161436

# --- Production values, pinned so a developer's local .env cannot leak in ---
#
# Vite loads the generic `.env` in EVERY mode and `.env.sanctuary` only
# overrides the keys it names. Anything omitted here is inherited from the
# local `.env` — which points at localhost:9001 and the Clerk *dev* instance.
# Sanctuary deploys by local rsync (not the `sm deploy_ui` / GitHub Actions
# path that injects these), so the PLAT-CLERK-PROD-1 rotation never reached
# it and production served pk_test_* until 2026-08-13. Pinning them makes
# that impossible. Same reasoning as smart-memory-web/.env.production.
#
# These pins are only half the fix: Vite ranks the *process* environment above
# every .env file, and a dev shell that has exported VITE_CLERK_PUBLISHABLE_KEY
# (the local docker-compose flow does) silently outranks this file. That is how
# production came to serve pk_test_* — the file said one thing and the shell
# said another. `build:sanctuary` therefore runs vite under `env -u` for each
# variable pinned below, so this file is the only voice in the room.
#
# Canonical source for the Clerk/PostHog values:
# smart-memory-infra/config/frontend-shared.env
VITE_API_URL=https://api.smartmemory.ai

# Clerk PRODUCTION instance (clerk.smartmemory.ai). Used by the non-embedded
# fallback branch in src/main.jsx — sanctuary.smartmemory.ai opened outside a
# Discord Activity renders the normal Clerk SSO app. svc-api stopped accepting
# the dev issuer in PLAT-CLERK-PROD-1 Phase D, so pk_test_* is not merely
# untidy here, it cannot authenticate.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc21hcnRtZW1vcnkuYWkk

# PostHog project 277617, org "SmartMemory AI". NOT phc_BFsq… — that token
# belongs to another org's project (277558) that ScaleMate also reports to.
# scripts/assert-prod-bundle.mjs refuses to publish a bundle carrying it.
VITE_PUBLIC_POSTHOG_KEY=phc_eGs3l5JzZLqjSKOGVRrRChCJX90umc0mU5Ju2WxuBSs
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
