# Sanctuary (Discord Activity) build profile.
#
# Vite picks this up when building with `--mode sanctuary` (i.e. the
# `build:sanctuary` script in package.json). Do NOT rename, move, or
# bypass — the Discord Activity boot path in src/main.jsx checks
# VITE_ALLOW_EMBEDDED at build time, so the fork is set at bake, not
# runtime. A rebuild without these values will silently regress the
# viewer to the Clerk path and hang at "Connecting to SmartMemory..."
# inside the Activity iframe.
#
# Both values are non-secret:
#   - VITE_ALLOW_EMBEDDED is a feature flag.
#   - VITE_DISCORD_CLIENT_ID is the Discord application id (the same
#     id that appears in every public invite URL for the Guru bot).

VITE_ALLOW_EMBEDDED=true
VITE_DISCORD_CLIENT_ID=1495424851375161436
